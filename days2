;WITH base AS (
  SELECT
    TRY_CONVERT(datetime2(0), [FECHA]) AS FECHA_DT,
    LTRIM(RTRIM(ACTIVADO)) AS ACTIVADO_N,
    FIRMA_NAME
  FROM dbo.CORPDW_CRM_LEGIT_PRODUCTOS_A_ACTIVAR_NEW
),
act AS (
  SELECT
    CAST(FECHA_DT AS date) AS DIA,
    CASE
      WHEN RIGHT(COALESCE(FIRMA_NAME,''), 4) COLLATE Latin1_General_100_CI_AS = '.jpg' THEN 'FACPOD'
      WHEN RIGHT(COALESCE(FIRMA_NAME,''), 4) COLLATE Latin1_General_100_CI_AS = '.png' THEN 'AXENTRIA'
      ELSE 'OTRO/NULL'
    END AS ORIGEN
  FROM base
  WHERE ACTIVADO_N COLLATE Latin1_General_100_CI_AS = 'si'
    AND FECHA_DT >= '2025-12-01'
    AND FECHA_DT <  '2026-01-01'
)
SELECT
  DIA,
  SUM(CASE WHEN ORIGEN='FACPOD'   THEN 1 ELSE 0 END) AS activados_facpod,
  SUM(CASE WHEN ORIGEN='AXENTRIA' THEN 1 ELSE 0 END) AS activados_axentria,
  COUNT(*) AS activados_total
FROM act
GROUP BY DIA
ORDER BY DIA;
