1) Total activados en diciembre 2025: FACPOD vs AXENTRIA

SELECT
  CASE
    WHEN FIRMA_NAME IS NOT NULL
     AND RIGHT(FIRMA_NAME, 4) COLLATE Latin1_General_100_CI_AS = '.jpg' THEN 'FACPOD'
    WHEN FIRMA_NAME IS NOT NULL
     AND RIGHT(FIRMA_NAME, 4) COLLATE Latin1_General_100_CI_AS = '.png' THEN 'AXENTRIA'
    ELSE 'OTRO/NULL'
  END AS ORIGEN,
  COUNT(*) AS activados
FROM dbo.CORPDW_CRM_LEGIT_PRODUCTOS_A_ACTIVAR_NEW
WHERE LTRIM(RTRIM(ACTIVADO)) COLLATE Latin1_General_100_CI_AS = 'si'
  AND ANHO_MES_DIA BETWEEN 20251201 AND 20251231
GROUP BY
  CASE
    WHEN FIRMA_NAME IS NOT NULL
     AND RIGHT(FIRMA_NAME, 4) COLLATE Latin1_General_100_CI_AS = '.jpg' THEN 'FACPOD'
    WHEN FIRMA_NAME IS NOT NULL
     AND RIGHT(FIRMA_NAME, 4) COLLATE Latin1_General_100_CI_AS = '.png' THEN 'AXENTRIA'
    ELSE 'OTRO/NULL'
  END
ORDER BY activados DESC;



2) Por día (diciembre 2025): activados facpod vs axentria + total
;WITH act AS (
  SELECT
    ANHO_MES_DIA,
    CASE
      WHEN FIRMA_NAME IS NOT NULL
       AND RIGHT(FIRMA_NAME, 4) COLLATE Latin1_General_100_CI_AS = '.jpg' THEN 'FACPOD'
      WHEN FIRMA_NAME IS NOT NULL
       AND RIGHT(FIRMA_NAME, 4) COLLATE Latin1_General_100_CI_AS = '.png' THEN 'AXENTRIA'
      ELSE 'OTRO/NULL'
    END AS ORIGEN
  FROM dbo.CORPDW_CRM_LEGIT_PRODUCTOS_A_ACTIVAR_NEW
  WHERE LTRIM(RTRIM(ACTIVADO)) COLLATE Latin1_General_100_CI_AS = 'si'
    AND ANHO_MES_DIA BETWEEN 20251201 AND 20251231
)
SELECT
  ANHO_MES_DIA,
  SUM(CASE WHEN ORIGEN='FACPOD'   THEN 1 ELSE 0 END) AS activados_facpod,
  SUM(CASE WHEN ORIGEN='AXENTRIA' THEN 1 ELSE 0 END) AS activados_axentria,
  COUNT(*) AS activados_total
FROM act
GROUP BY ANHO_MES_DIA
ORDER BY ANHO_MES_DIA;


3) Solo FACPOD por día + % sobre total activado del día
;WITH act AS (
  SELECT
    ANHO_MES_DIA,
    CASE
      WHEN FIRMA_NAME IS NOT NULL
       AND RIGHT(FIRMA_NAME, 4) COLLATE Latin1_General_100_CI_AS = '.jpg' THEN 1
      ELSE 0
    END AS ES_FACPOD
  FROM dbo.CORPDW_CRM_LEGIT_PRODUCTOS_A_ACTIVAR_NEW
  WHERE LTRIM(RTRIM(ACTIVADO)) COLLATE Latin1_General_100_CI_AS = 'si'
    AND ANHO_MES_DIA BETWEEN 20251201 AND 20251231
)
SELECT
  ANHO_MES_DIA,
  SUM(ES_FACPOD) AS activados_facpod,
  COUNT(*) AS activados_total_dia,
  CAST(100.0 * SUM(ES_FACPOD) / NULLIF(COUNT(*),0) AS DECIMAL(10,2)) AS pct_facpod_del_dia
FROM act
GROUP BY ANHO_MES_DIA
ORDER BY ANHO_MES_DIA;
