cant_denom_mes :=
VAR MesEnContexto =
    DATE(YEAR(MAX('Calendario'[Fecha])), MONTH(MAX('Calendario'[Fecha])), 1)

VAR MinActual = DATE(YEAR(MIN(TC_ACTIV_CRD_ACTUAL_MONTH[FECHA_FILT])), MONTH(MIN(TC_ACTIV_CRD_ACTUAL_MONTH[FECHA_FILT])), 1)
VAR MaxActual = DATE(YEAR(MAX(TC_ACTIV_CRD_ACTUAL_MONTH[FECHA_FILT])), MONTH(MAX(TC_ACTIV_CRD_ACTUAL_MONTH[FECHA_FILT])), 1)

VAR UsarActual =
    MesEnContexto >= MinActual && MesEnContexto <= MaxActual

RETURN
IF(
    UsarActual,
    CALCULATE(
        COUNTROWS(TC_ACTIV_CRD_ACTUAL_MONTH),
        NOT(ISBLANK(TC_ACTIV_CRD_ACTUAL_MONTH[FECHA_FILT]))
    ),
    CALCULATE(
        COUNTROWS(TC_ACTIV_CRD_LAST_YEAR),
        NOT(ISBLANK(TC_ACTIV_CRD_LAST_YEAR[FECHA_FILT]))
    )
)
