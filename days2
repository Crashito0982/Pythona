;WITH base AS (
  SELECT
    TRY_CONVERT(datetime2(0), FECHA) AS FECHA_DT,
    UPPER(LTRIM(RTRIM(ACTIVADO))) AS ACTIVADO_N,
    UPPER(LTRIM(RTRIM(FIRMA_NAME))) AS FIRMA_N
  FROM dbo.CORPDW_CRM_LEGIT_PRODUCTOS_A_ACTIVAR_NEW
),
act AS (
  SELECT
    FECHA_DT,
    CASE
      WHEN FIRMA_N LIKE '%.JPG' OR FIRMA_N LIKE '%.JPEG' THEN 'FACPOD'
      WHEN FIRMA_N LIKE '%.PNG' THEN 'AXENTRIA'
      ELSE 'OTRO/NULL'
    END AS ORIGEN
  FROM base
  WHERE ACTIVADO_N = 'SI'
    AND FECHA_DT >= '2025-12-01'
    AND FECHA_DT <  '2026-01-01'
)
SELECT
  ORIGEN,
  COUNT(*) AS activados
FROM act
GROUP BY ORIGEN
ORDER BY activados DESC;




;WITH base AS (
  SELECT
    TRY_CONVERT(datetime2(0), FECHA) AS FECHA_DT,
    UPPER(LTRIM(RTRIM(ACTIVADO))) AS ACTIVADO_N,
    UPPER(LTRIM(RTRIM(FIRMA_NAME))) AS FIRMA_N
  FROM dbo.CORPDW_CRM_LEGIT_PRODUCTOS_A_ACTIVAR_NEW
),
act AS (
  SELECT
    CAST(FECHA_DT AS date) AS DIA,
    CASE
      WHEN FIRMA_N LIKE '%.JPG' OR FIRMA_N LIKE '%.JPEG' THEN 'FACPOD'
      WHEN FIRMA_N LIKE '%.PNG' THEN 'AXENTRIA'
      ELSE 'OTRO/NULL'
    END AS ORIGEN
  FROM base
  WHERE ACTIVADO_N = 'SI'
    AND FECHA_DT >= '2025-12-01'
    AND FECHA_DT <  '2026-01-01'
)
SELECT
  DIA,
  SUM(CASE WHEN ORIGEN = 'FACPOD'  THEN 1 ELSE 0 END) AS activados_facpod,
  SUM(CASE WHEN ORIGEN = 'AXENTRIA' THEN 1 ELSE 0 END) AS activados_axentria,
  SUM(CASE WHEN ORIGEN = 'OTRO/NULL' THEN 1 ELSE 0 END) AS activados_otro,
  COUNT(*) AS activados_total
FROM act
GROUP BY DIA
ORDER BY DIA;



;WITH base AS (
  SELECT
    TRY_CONVERT(datetime2(0), FECHA) AS FECHA_DT,
    UPPER(LTRIM(RTRIM(ACTIVADO))) AS ACTIVADO_N,
    UPPER(LTRIM(RTRIM(FIRMA_NAME))) AS FIRMA_N
  FROM dbo.CORPDW_CRM_LEGIT_PRODUCTOS_A_ACTIVAR_NEW
),
act AS (
  SELECT
    CAST(FECHA_DT AS date) AS DIA,
    CASE
      WHEN FIRMA_N LIKE '%.JPG' OR FIRMA_N LIKE '%.JPEG' THEN 1 ELSE 0
    END AS ES_FACPOD
  FROM base
  WHERE ACTIVADO_N = 'SI'
    AND FECHA_DT >= '2025-12-01'
    AND FECHA_DT <  '2026-01-01'
)
SELECT
  DIA,
  SUM(ES_FACPOD) AS activados_facpod,
  COUNT(*) AS activados_total_dia,
  CAST(100.0 * SUM(ES_FACPOD) / NULLIF(COUNT(*), 0) AS DECIMAL(10,2)) AS pct_facpod_del_dia
FROM act
GROUP BY DIA
ORDER BY DIA;
