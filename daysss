SELECT
  CASE
    WHEN FIRMA_NAME LIKE '%.jpg' OR FIRMA_NAME LIKE '%.jpeg' THEN 'FACPOD'
    WHEN FIRMA_NAME LIKE '%.png' THEN 'AXENTRIA'
    ELSE 'OTRO/NULL'
  END AS ORIGEN,
  COUNT(*) AS activados
FROM dbo.CORPDW_CRM_LEGIT_PRODUCTOS_A_ACTIVAR_NEW
WHERE LTRIM(RTRIM(ACTIVADO)) = 'si'
  AND ANHO_MES_DIA BETWEEN 20251201 AND 20251231
GROUP BY
  CASE
    WHEN FIRMA_NAME LIKE '%.jpg' OR FIRMA_NAME LIKE '%.jpeg' THEN 'FACPOD'
    WHEN FIRMA_NAME LIKE '%.png' THEN 'AXENTRIA'
    ELSE 'OTRO/NULL'
  END
ORDER BY activados DESC;




Por día: activados facpod vs axentria + total (diciembre 2025)
;WITH act AS (
  SELECT
    ANHO_MES_DIA,
    CASE
      WHEN FIRMA_NAME LIKE '%.jpg' OR FIRMA_NAME LIKE '%.jpeg' THEN 'FACPOD'
      WHEN FIRMA_NAME LIKE '%.png' THEN 'AXENTRIA'
      ELSE 'OTRO/NULL'
    END AS ORIGEN
  FROM dbo.CORPDW_CRM_LEGIT_PRODUCTOS_A_ACTIVAR_NEW
  WHERE LTRIM(RTRIM(ACTIVADO)) = 'si'
    AND ANHO_MES_DIA BETWEEN 20251201 AND 20251231
)
SELECT
  ANHO_MES_DIA,
  SUM(CASE WHEN ORIGEN='FACPOD' THEN 1 ELSE 0 END) AS activados_facpod,
  SUM(CASE WHEN ORIGEN='AXENTRIA' THEN 1 ELSE 0 END) AS activados_axentria,
  COUNT(*) AS activados_total
FROM act
GROUP BY ANHO_MES_DIA
ORDER BY ANHO_MES_DIA;




FACPOD por día + % sobre el total activado del día
;WITH act AS (
  SELECT
    ANHO_MES_DIA,
    CASE WHEN FIRMA_NAME LIKE '%.jpg' OR FIRMA_NAME LIKE '%.jpeg' THEN 1 ELSE 0 END AS ES_FACPOD
  FROM dbo.CORPDW_CRM_LEGIT_PRODUCTOS_A_ACTIVAR_NEW
  WHERE LTRIM(RTRIM(ACTIVADO)) = 'si'
    AND ANHO_MES_DIA BETWEEN 20251201 AND 20251231
)
SELECT
  ANHO_MES_DIA,
  SUM(ES_FACPOD) AS activados_facpod,
  COUNT(*) AS activados_total_dia,
  CAST(100.0 * SUM(ES_FACPOD) / NULLIF(COUNT(*),0) AS DECIMAL(10,2)) AS pct_facpod_del_dia
FROM act
GROUP BY ANHO_MES_DIA
ORDER BY ANHO_MES_DIA;
