;WITH base AS (
    SELECT
        h.NOMBRE_ARCHIVO_CI,
        h.FECHA_CARGA,
        ax.nombre_logico,
        ax.fecha_creacion,
        CASE
            WHEN ax.fecha_creacion >= DATEADD(DAY, -15, h.FECHA_CARGA)
             AND ax.fecha_creacion <= h.FECHA_CARGA
            THEN 1 ELSE 0
        END AS CI_EN_RANGO_15D
    FROM dbo.ls_legit_ci_images_hash h
    LEFT JOIN dbo.LS_ULTIMO_CI_AXNT_FULL ax
        ON ax.nombre_logico = h.NOMBRE_ARCHIVO_CI
    WHERE h.FECHA_CARGA >= DATEADD(DAY, -15, GETDATE())
)
SELECT
    COUNT(*) AS total_hash_ult_15d,
    SUM(CASE WHEN nombre_logico IS NOT NULL THEN 1 ELSE 0 END) AS matchean_en_axnt,
    SUM(CI_EN_RANGO_15D) AS matchean_y_en_rango_15d,
    CAST(100.0 * SUM(CI_EN_RANGO_15D) / NULLIF(COUNT(*), 0) AS DECIMAL(10,2)) AS pct_en_rango_sobre_total
FROM base;



;WITH base AS (
    SELECT
        CAST(h.FECHA_CARGA AS date) AS dia_carga,
        h.NOMBRE_ARCHIVO_CI,
        h.FECHA_CARGA,
        ax.nombre_logico,
        ax.fecha_creacion,
        CASE
            WHEN ax.fecha_creacion >= DATEADD(DAY, -15, h.FECHA_CARGA)
             AND ax.fecha_creacion <= h.FECHA_CARGA
            THEN 1 ELSE 0
        END AS CI_EN_RANGO_15D
    FROM dbo.ls_legit_ci_images_hash h
    LEFT JOIN dbo.LS_ULTIMO_CI_AXNT_FULL ax
        ON ax.nombre_logico = h.NOMBRE_ARCHIVO_CI
    WHERE h.FECHA_CARGA >= DATEADD(DAY, -15, GETDATE())
)
SELECT
    dia_carga,
    COUNT(*) AS total_hash_dia,
    SUM(CASE WHEN nombre_logico IS NOT NULL THEN 1 ELSE 0 END) AS matchean_en_axnt,
    SUM(CI_EN_RANGO_15D) AS matchean_y_en_rango_15d,
    CAST(100.0 * SUM(CI_EN_RANGO_15D) / NULLIF(COUNT(*), 0) AS DECIMAL(10,2)) AS pct_en_rango_sobre_total
FROM base
GROUP BY dia_carga
ORDER BY dia_carga;
